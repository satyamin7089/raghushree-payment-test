# ==============================================================================
# Raghushree Independent Application — Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Database & Supabase
# Use DB_DRIVER=pg with DATABASE_URL + SUPABASE_* in staging/production.
# DB_DRIVER=pglite runs an embedded PostgreSQL 16 engine for zero-dependency local dev/testing.
DB_DRIVER=pglite
PGLITE_DATA_DIR=.pglite-data
DATABASE_URL=

# Supabase Credentials (Backend ONLY — never expose SERVICE_ROLE_KEY to React!)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-media

# Auth Session Secret (min 32 chars in production)
AUTH_JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Razorpay (Server-side only — Test keys start with rzp_test_, Live keys with rzp_live_)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (Server-side only — Used for rate quotes only, never shipment booking)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=208001

# SMTP Email Notifications (for RFQ enquiries)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@raghushree.com

# Bootstrap initial admin user (only used on empty database)
BOOTSTRAP_ADMIN_EMAIL=admin@raghushree.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow123!
BOOTSTRAP_ADMIN_NAME=Raghushree Administrator
