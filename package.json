{
  "name": "raghushree-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "scripts/migrate-wp"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@raghushree/api run dev",
    "dev:web": "npm --workspace=@raghushree/web run dev",
    "build": "npm --workspace=@raghushree/web run build && npm --workspace=@raghushree/api run build",
    "start": "npm --workspace=@raghushree/api run start",
    "test": "npm --workspace=@raghushree/api test && npm --workspace=@raghushree/web test",
    "migrate:wp": "npm --workspace=@raghushree/migrate-wp run migrate"
  }
}
